{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "pureza": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/styles.scss"],
            // Keeps the relative url() font references in _typography.scss out of
            // the bundle. They must stay RELATIVE so <base href> applies on a
            // sub-path deploy (GitHub Pages project site), but esbuild resolves any
            // non-absolute url() against the filesystem and fails the build because
            // the woff2 files live in public/, not next to the stylesheet. Marking
            // them external is esbuild's own documented escape (it is literally what
            // the error message suggests) and emits the path untouched. The fonts are
            // still shipped — as public/ assets, with stable unhashed names, which is
            // what the index.html preload needs.
            "externalDependencies": ["fonts/*.woff2"],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": []
            },
            "ssr": {
              "entry": "src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "5kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": { "minify": true, "inlineCritical": true },
                // DO NOT ENABLE. fonts.inline inlines the Google/Adobe Fonts *CSS*, but the
                // @font-face src inside that CSS still points at fonts.gstatic.com — an
                // external runtime request. This project forbids external font CDNs; fonts
                // are self-hosted from public/fonts (see foundation design.md §2, PR2).
                "fonts": { "inline": false }
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "pureza:build:production"
            },
            "development": {
              "buildTarget": "pureza:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest",
            "buildTarget": "::development"
          }
        }
      }
    }
  }
}
