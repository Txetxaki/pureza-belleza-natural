{
  "name": "pureza",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "node scripts/validate-keyword-uniqueness.mjs && node scripts/generate-image-variants.mjs",
    "build": "ng build",
    "postbuild": "node scripts/generate-sitemap.mjs",
    "watch": "ng build --watch --configuration development",
